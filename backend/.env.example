# Copy to .env and adjust. Unset values fall back to lightweight local defaults.

# --- Persistence ---
# Local default is SQLite (no service needed). For the production stack:
# DATABASE_URL=postgresql+psycopg2://tracknifty:tracknifty@db:5432/tracknifty
# DATABASE_URL=sqlite:///./tracknifty.db

# --- Cache ---
# Leave unset for an in-memory cache; set for Redis.
# REDIS_URL=redis://redis:6379/0

# --- Scheduler ---
# apscheduler (in-process, default) or celery (uses Redis broker)
# SCHEDULER=apscheduler
# ENABLE_SCHEDULER=true

# --- Price provider ---
# auto (try yfinance, fall back to synthetic) | yfinance | synthetic
# PRICE_PROVIDER=auto
# PRICE_HISTORY_YEARS=5

# --- Model store ---
# local (default) or s3
# MODEL_STORE=local
# S3_BUCKET=my-bucket

# --- Auth (CHANGE IN PRODUCTION) ---
# JWT_SECRET=use-a-long-random-string-at-least-32-bytes
# JWT_EXPIRE_MINUTES=720

# --- Label construction (sign off with the investment team) ---
# LABEL_FORWARD_DAYS=63
# LABEL_BUY_ALPHA_PCT=5.0
# LABEL_SELL_ALPHA_PCT=-5.0
